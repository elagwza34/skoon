# Copy to a local, ignored `.env.staging` file. Never put production values here.
# Use a completely separate Supabase project for staging.
# Runtime queries use the pooled connection; migrations use the direct connection.
DATABASE_URL="postgresql://postgres.<STAGING_PROJECT_REF>:<PASSWORD>@aws-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<PASSWORD>@db.<STAGING_PROJECT_REF>.supabase.co:5432/postgres"

# Required by scripts/validate-staging-env.cjs. The acknowledgement is a
# deliberate guard against accidental migration/test execution on production.
SKOON_STAGING_PROJECT_REF="your-separate-staging-project-ref"
SKOON_STAGING_ACKNOWLEDGEMENT="isolated-staging-only"
SKOON_STAGING_DATABASE_URL="same-value-as-DATABASE_URL"
SKOON_FINANCIAL_TEST_DATABASE_URL="same-value-as-DATABASE_URL"

# Local PostgreSQL alternative. Use this only for the dedicated, localhost-only
# `skoon_variants_dev` database; do not combine it with any Supabase URL.
# DATABASE_URL="postgresql://skoon_variants_dev:<LOCAL_PASSWORD>@127.0.0.1:4444/skoon_variants_dev"
# DIRECT_URL="postgresql://skoon_variants_dev:<LOCAL_PASSWORD>@127.0.0.1:4444/skoon_variants_dev"
# SKOON_STAGING_DATABASE_URL="same-value-as-DATABASE_URL"
# SKOON_STAGING_PROJECT_REF="local-postgres-17"
# SKOON_LOCAL_DEVELOPMENT_DATABASE="localhost-only"

# Configure normal server-only values for the separate staging project.
NEXT_PUBLIC_SUPABASE_URL="https://<STAGING_PROJECT_REF>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="staging-anon-key"
SUPABASE_SERVICE_ROLE_KEY="staging-service-role-key"
CRON_SECRET="staging-cron-secret"
