{
  "name": "cafe-system",
  "version": "1.0.0",
  "private": true,
  "description": "Cafe Management System — Next.js + TypeScript + Prisma",
  "license": "Proprietary",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --require ./tests/node-userinfo-workaround.cjs --import tsx --test tests/offline.test.ts",
    "test:financial": "node scripts/with-staging-env.cjs --guard node --require ./tests/node-userinfo-workaround.cjs --import tsx --test --test-concurrency=1 tests/financial-postgres.test.ts",
    "test:cashier-acceptance": "node scripts/with-staging-env.cjs --guard node --require ./tests/node-userinfo-workaround.cjs --import tsx --test --test-concurrency=1 tests/cashier-postgres.test.ts",
    "staging:check": "node scripts/with-staging-env.cjs node scripts/validate-staging-env.cjs",
    "staging:migrate": "node scripts/with-staging-env.cjs --guard npx prisma migrate deploy",
    "staging:status": "node scripts/with-staging-env.cjs --guard npx prisma migrate status",
    "test:inventory": "node scripts/with-authorized-test-env.cjs node --require ./tests/node-userinfo-workaround.cjs --import tsx --test --test-concurrency=1 tests/inventory-postgres.test.ts",
    "test:hr": "node scripts/with-authorized-test-env.cjs node --require ./tests/node-userinfo-workaround.cjs --import tsx --test --test-concurrency=1 tests/hr-postgres.test.ts",
    "test:service-requests": "node scripts/with-authorized-test-env.cjs node --require ./tests/node-userinfo-workaround.cjs --import tsx --test --test-reporter=spec --test-concurrency=1 tests/service-requests-postgres.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "node scripts/forbid-prisma-production-migrate.cjs",
    "prisma:db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "next": "15.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
