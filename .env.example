// .env.example — never commit secrets. Copy to .env (managed in hPanel).
// ALL values below are PLACEHOLDERS. Never put real secrets in this file.
// Stack: Next.js + Supabase PostgreSQL + Supabase Auth + Prisma.

# --- Database (Supabase PostgreSQL) ---
# Prefer the POOLED connection (PgBouncer, port 6543) for the running app on shared
# hosting. Use the DIRECT connection (5432) only for migrations from a stable-IP env.
# Values come from Supabase → Project Settings → Database → Connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Supabase Auth ---
# URL + anon key are safe to expose to the browser.
# The service-role key is SERVER-ONLY — never expose via NEXT_PUBLIC_*, logs, or Git.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-server-only"

# --- Application ---
APP_URL="https://skoon.awexen.com"
# NODE_ENV="development"   # Hostinger sets this automatically

# --- Cron (protected route) ---
CRON_SECRET="change-me-to-32-random-chars"
