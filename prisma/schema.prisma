// ============================================================================
// Cafe Management System — Prisma Schema (single source of truth)
// Stack: Next.js + TypeScript + Prisma + Supabase PostgreSQL + Supabase Auth
// Rules: BIGINT PKs · NUMERIC(10,2) money · soft deletes ·
//        branch scoping · VARCHAR enums (validated in app layer)
// Prisma is the runtime ORM. Production schema changes are executed through
// reviewed Supabase migrations; do not run `prisma migrate deploy`.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Phase A: MySQL -> PostgreSQL; Supabase Auth owns credentials (custom-password auth removed).
// See docs/PHASE-A-POSTGRES-SUPABASE-AUTH.md

// ============================ CORE / AUTH ============================

model CafeBranch {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(100)
  code      String   @unique @db.VarChar(20)
  phone     String?  @db.VarChar(20)
  address   String?  @db.VarChar(255)
  timezone  String   @default("Africa/Cairo") @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                       User[]
  cafeTables                  CafeTable[]
  categories                  Category[]
  products                    Product[]
  productAttributes           ProductAttribute[]
  measurementUnits            MeasurementUnit[]
  orders                      Order[]
  payments                    Payment[]
  discounts                   Discount[]
  inventoryItems              InventoryItem[]
  inventoryTransactions       InventoryTransaction[]
  inventoryBatches            InventoryBatch[]
  inventoryReservations       InventoryReservation[]
  wasteEvents                 WasteEvent[]
  employeeAccountability      EmployeeAccountability[]
  stockCounts                 StockCount[]
  wasteOperations             WasteOperation[]
  auditLogs                   AuditLog[]
  shifts                      Shift[]
  financialMovements          FinancialMovement[]
  financialOperations         FinancialOperation[]
  employeeProfiles            EmployeeProfile[]
  employeeContracts           EmploymentContract[]
  orderResponsibilityHistory  OrderResponsibilityHistory[]
  orderTableTransfers         OrderTableTransfer[]
  waiterShiftHandovers        WaiterShiftHandover[]
  compensationRates           CompensationRate[]
  workSchedules               WorkSchedule[]
  attendanceCorrections       AttendanceCorrection[]
  leaveRequests               LeaveRequest[]
  officialHolidays            OfficialHoliday[]
  serviceRequests             ServiceRequest[]
  waiterReconciliationReviews WaiterOrderReconciliationReview[]
  waiterReconciliationAudits  WaiterOrderReconciliationAudit[]

  @@index([isActive])
  @@map("branches")
}

model Role {
  id          BigInt   @id @default(autoincrement())
  slug        String   @unique @db.VarChar(30)
  name        String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id        BigInt   @id @default(autoincrement())
  slug      String   @unique @db.VarChar(60)
  name      String   @db.VarChar(100)
  groupName String   @map("group") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@index([groupName])
  @@map("permissions")
}

model RolePermission {
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model User {
  // id == Supabase Auth user id (auth.uid()). Assigned by the trusted server-side
  // provisioning flow so it always matches the Supabase identity. Intentionally NO
  // Prisma relation to auth.users: Prisma must not manage the Supabase auth schema.
  id           String    @id @db.Uuid
  branchId     BigInt?   @map("branch_id")
  roleId       BigInt    @map("role_id")
  name         String    @db.VarChar(100)
  email        String?   @unique @db.VarChar(150)
  phone        String?   @db.VarChar(20)
  // Monthly salary — stored using monetary precision; editable only by owner/manager.
  salary       Decimal   @default(0) @map("salary") @db.Decimal(10, 2)
  avatarPath   String?   @map("avatar_path") @db.VarChar(255)
  // Employee POS PIN — SECURE STORAGE. Stores ONLY a bcrypt hash (never plaintext).
  // Distinct from Supabase Auth credentials; verified server-side only.
  // See docs/PIN-SECURITY-DESIGN.md. VarChar(255) leaves room for future pepper/algo change.
  pinHash      String?   @map("pin_hash") @db.VarChar(255)
  pinUpdatedAt DateTime? @map("pin_updated_at")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // REMOVED (Supabase Auth owns credentials): passwordHash, failedLoginCount,
  // lockedUntil, mustChangePassword.

  role                                Role                              @relation(fields: [roleId], references: [id])
  branch                              CafeBranch?                       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdOrders                       Order[]                           @relation("orderCreatedBy")
  qrDecidedOrders                     Order[]                           @relation("orderQrDecisionBy")
  statusChanges                       OrderStatusHistory[]              @relation("statusChangedBy")
  payments                            Payment[]                         @relation("paymentPaidBy")
  createdDiscounts                    Discount[]                        @relation("discountCreatedBy")
  inventoryTransactions               InventoryTransaction[]            @relation("txnCreatedBy")
  preparationStartedItems             OrderItem[]                       @relation("itemPreparationStartedBy")
  responsibleWasteEvents              WasteEvent[]                      @relation("wasteResponsible")
  recordedWasteEvents                 WasteEvent[]                      @relation("wasteRecordedBy")
  accountabilityRecords               EmployeeAccountability[]          @relation("accountabilityEmployee")
  reviewedAccountability              EmployeeAccountability[]          @relation("accountabilityReviewer")
  accountabilityWaivers               AccountabilityWaiver[]            @relation("waiverManager")
  responsibleStockCounts              StockCount[]                      @relation("stockCountResponsible")
  postedStockCounts                   StockCount[]                      @relation("stockCountPostedBy")
  auditLogs                           AuditLog[]
  updatedSettings                     AppSetting[]                      @relation("settingUpdatedBy")
  cashierShifts                       Shift[]                           @relation("shiftCashier")
  financialMovements                  FinancialMovement[]               @relation("movementActor")
  receivedMovements                   FinancialMovement[]               @relation("movementRecipient")
  // Notifications sent to this user (order status transitions, payments).
  notifications                       Notification[]
  employeeProfile                     EmployeeProfile?                  @relation("employeeProfileUser")
  archivedEmployeeProfiles            EmployeeProfile[]                 @relation("employeeProfileArchivedBy")
  uploadedEmployeeContracts           EmploymentContract[]              @relation("employeeContractUploadedBy")
  compensationSetBy                   CompensationRate[]                @relation("compensationSetBy")
  scheduledWork                       WorkSchedule[]                    @relation("workScheduleEmployee")
  createdWorkSchedules                WorkSchedule[]                    @relation("workScheduleCreatedBy")
  attendanceCorrections               AttendanceCorrection[]            @relation("attendanceCorrectionEmployee")
  proposedCorrections                 AttendanceCorrection[]            @relation("attendanceCorrectionProposedBy")
  approvedCorrections                 AttendanceCorrection[]            @relation("attendanceCorrectionApprovedBy")
  leaveRequests                       LeaveRequest[]                    @relation("leaveEmployee")
  reviewedLeaveRequests               LeaveRequest[]                    @relation("leaveReviewedBy")
  createdOfficialHolidays             OfficialHoliday[]                 @relation("holidayCreatedBy")
  claimedServiceRequests              ServiceRequest[]                  @relation("serviceRequestClaimedBy")
  resolvedServiceRequests             ServiceRequest[]                  @relation("serviceRequestResolvedBy")
  responsibleOrders                   Order[]                           @relation("orderResponsibleWaiter")
  responsibilityAssigned              OrderResponsibilityHistory[]      @relation("orderResponsibilityAssignedBy")
  responsibilityReceived              OrderResponsibilityHistory[]      @relation("orderResponsibilityAssignedTo")
  requestedWaiterHandovers            WaiterShiftHandover[]             @relation("waiterHandoverRequestedBy")
  receivedWaiterHandovers             WaiterShiftHandover[]             @relation("waiterHandoverRecipient")
  tableTransfersMade                  OrderTableTransfer[]
  waiterReconciliationReviewsAuthored WaiterOrderReconciliationReview[] @relation("waiterReconciliationReviewer")
  waiterReconciliationReviewsApproved WaiterOrderReconciliationReview[] @relation("waiterReconciliationApprover")
  waiterReconciliationWaiters         WaiterOrderReconciliationReview[] @relation("waiterReconciliationProposedWaiter")
  waiterReconciliationAuditEvents     WaiterOrderReconciliationAudit[]  @relation("waiterReconciliationAuditActor")

  @@index([roleId])
  @@index([branchId, isActive])
  @@map("users")
}

// ============================ HR FOUNDATION ============================
// The HR domain is deliberately separated from the authentication profile.
// User remains the durable Supabase Auth-linked identity; this model stores
// employee lifecycle data and is never hard-deleted through HR workflows.
model EmployeeProfile {
  id                    BigInt    @id @default(autoincrement())
  userId                String    @unique @map("user_id") @db.Uuid
  // Owner profiles are intentionally cross-branch; operational employees are
  // branch-scoped. Do not turn this into employee-transfer functionality.
  branchId              BigInt?   @map("branch_id")
  employmentStatus      String    @default("active") @map("employment_status") @db.VarChar(30)
  employmentType        String?   @map("employment_type") @db.VarChar(30)
  hireDate              DateTime? @map("hire_date") @db.Date
  probationStart        DateTime? @map("probation_start") @db.Date
  probationEnd          DateTime? @map("probation_end") @db.Date
  probationStatus       String?   @map("probation_status") @db.VarChar(30)
  probationReviewedAt   DateTime? @map("probation_reviewed_at")
  probationDecision     String?   @map("probation_decision") @db.VarChar(30)
  personalEmail         String?   @map("personal_email") @db.VarChar(150)
  personalPhone         String?   @map("personal_phone") @db.VarChar(30)
  address               String?   @db.VarChar(500)
  emergencyContactName  String?   @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactPhone String?   @map("emergency_contact_phone") @db.VarChar(30)
  nationalIdCiphertext  String?   @map("national_id_ciphertext") @db.Text
  archivedAt            DateTime? @map("archived_at")
  archivedById          String?   @map("archived_by") @db.Uuid
  archiveReason         String?   @map("archive_reason") @db.VarChar(255)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user              User                 @relation("employeeProfileUser", fields: [userId], references: [id], onDelete: Restrict)
  branch            CafeBranch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  archivedBy        User?                @relation("employeeProfileArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  contracts         EmploymentContract[]
  compensationRates CompensationRate[]

  @@index([branchId, employmentStatus])
  @@index([archivedAt])
  @@map("employee_profiles")
}

// Immutable historical contract rows. Renewals create a new row instead of
// overwriting a prior contract.
model EmploymentContract {
  id             BigInt    @id @default(autoincrement())
  employeeId     BigInt    @map("employee_id")
  branchId       BigInt?   @map("branch_id")
  contractType   String    @map("contract_type") @db.VarChar(30)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveUntil DateTime? @map("effective_until") @db.Date
  documentPath   String?   @map("document_path") @db.VarChar(500)
  notes          String?   @db.Text
  supersedesId   BigInt?   @map("supersedes_id")
  uploadedById   String    @map("uploaded_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  employee   EmployeeProfile      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  branch     CafeBranch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supersedes EmploymentContract?  @relation("contractRenewal", fields: [supersedesId], references: [id], onDelete: Restrict)
  renewals   EmploymentContract[] @relation("contractRenewal")
  uploadedBy User                 @relation("employeeContractUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveFrom])
  @@index([branchId, effectiveUntil])
  @@map("employment_contracts")
}

// Effective-dated compensation is historical. Payroll must select the rate in
// force for the covered date rather than mutate a prior approved period.
model CompensationRate {
  id               BigInt    @id @default(autoincrement())
  employeeId       BigInt    @map("employee_id")
  branchId         BigInt?   @map("branch_id")
  compensationType String    @map("compensation_type") @db.VarChar(20)
  paymentFrequency String    @map("payment_frequency") @db.VarChar(20)
  amount           Decimal   @db.Decimal(12, 2)
  currency         String    @default("EGP") @db.VarChar(3)
  effectiveFrom    DateTime  @map("effective_from") @db.Date
  effectiveUntil   DateTime? @map("effective_until") @db.Date
  setById          String    @map("set_by") @db.Uuid
  reason           String?   @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")

  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  branch   CafeBranch?     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  setBy    User            @relation("compensationSetBy", fields: [setById], references: [id], onDelete: Restrict)

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
  @@index([branchId, effectiveFrom])
  @@map("compensation_rates")
}

// Schedule revisions are effective dated; actual attendance continues to come
// exclusively from Shift timestamps rather than a second clock system.
model WorkSchedule {
  id             BigInt    @id @default(autoincrement())
  employeeId     String    @map("employee_id") @db.Uuid
  branchId       BigInt    @map("branch_id")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveUntil DateTime? @map("effective_until") @db.Date
  timezone       String    @default("Africa/Cairo") @db.VarChar(50)
  graceMinutes   Int       @default(0) @map("grace_minutes")
  status         String    @default("active") @db.VarChar(20)
  createdById    String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  employee  User              @relation("workScheduleEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  branch    CafeBranch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User              @relation("workScheduleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  days      WorkScheduleDay[]

  @@index([employeeId, effectiveFrom])
  @@index([branchId, status])
  @@map("work_schedules")
}

model WorkScheduleDay {
  id         BigInt       @id @default(autoincrement())
  scheduleId BigInt       @map("schedule_id")
  weekday    Int          @db.SmallInt
  restDay    Boolean      @default(false) @map("rest_day")
  startsAt   String?      @map("starts_at") @db.VarChar(5)
  endsAt     String?      @map("ends_at") @db.VarChar(5)
  schedule   WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  intervals  WorkScheduleInterval[]

  @@unique([scheduleId, weekday])
  @@map("work_schedule_days")
}

model AttendanceCorrection {
  id               BigInt    @id @default(autoincrement())
  branchId         BigInt    @map("branch_id")
  employeeId       String    @map("employee_id") @db.Uuid
  shiftId          BigInt?   @map("shift_id")
  proposedById     String    @map("proposed_by") @db.Uuid
  approvedById     String?   @map("approved_by") @db.Uuid
  status           String    @default("pending") @db.VarChar(20)
  reason           String    @db.VarChar(500)
  proposedOpenedAt DateTime? @map("proposed_opened_at")
  proposedClosedAt DateTime? @map("proposed_closed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  decidedAt        DateTime? @map("decided_at")

  branch     CafeBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  employee   User       @relation("attendanceCorrectionEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  shift      Shift?     @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  proposedBy User       @relation("attendanceCorrectionProposedBy", fields: [proposedById], references: [id], onDelete: Restrict)
  approvedBy User?      @relation("attendanceCorrectionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([employeeId, status, createdAt])
  @@index([branchId, status])
  @@map("attendance_corrections")
}

/// Leave rows become immutable after a final decision; balances are derived from approved requests.
model LeaveRequest {
  id           BigInt    @id @default(autoincrement())
  branchId     BigInt    @map("branch_id")
  employeeId   String    @map("employee_id") @db.Uuid
  type         String    @db.VarChar(30)
  status       String    @default("pending") @db.VarChar(20)
  startsOn     DateTime  @map("starts_on") @db.Date
  endsOn       DateTime  @map("ends_on") @db.Date
  days         Decimal   @db.Decimal(6, 2)
  isPaid       Boolean?  @map("is_paid")
  reason       String    @db.VarChar(500)
  reviewerId   String?   @map("reviewer_id") @db.Uuid
  decisionNote String?   @map("decision_note") @db.VarChar(500)
  decidedAt    DateTime? @map("decided_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  branch   CafeBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  employee User       @relation("leaveEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  reviewer User?      @relation("leaveReviewedBy", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([employeeId, status, startsOn])
  @@index([branchId, status, startsOn])
  @@map("leave_requests")
}

model OfficialHoliday {
  id          BigInt   @id @default(autoincrement())
  branchId    BigInt?  @map("branch_id")
  name        String   @db.VarChar(150)
  startsOn    DateTime @map("starts_on") @db.Date
  endsOn      DateTime @map("ends_on") @db.Date
  isPaid      Boolean?  @map("is_paid")
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  branch    CafeBranch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User        @relation("holidayCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([branchId, startsOn])
  @@map("official_holidays")
}

// ============================ HR PHASE DRAFT ============================
// These records are additive and intentionally have no production writer until
// their local migration is separately reviewed and deployed.
model WorkScheduleInterval {
  id                 BigInt          @id @default(autoincrement())
  scheduleDayId      BigInt          @map("schedule_day_id")
  startsAt           String          @map("starts_at") @db.VarChar(5)
  endsAt             String          @map("ends_at") @db.VarChar(5)
  unpaidBreakMinutes Int             @default(0) @map("unpaid_break_minutes")
  scheduleDay        WorkScheduleDay @relation(fields: [scheduleDayId], references: [id], onDelete: Cascade)

  @@index([scheduleDayId])
  @@map("work_schedule_intervals")
}

model EmployeeDocument {
  id           BigInt   @id @default(autoincrement())
  employeeId   BigInt   @map("employee_id")
  kind         String   @db.VarChar(40)
  storagePath  String   @map("storage_path") @db.VarChar(500)
  uploadedById String   @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([employeeId, kind, storagePath])
  @@index([employeeId, kind])
  @@map("employee_documents")
}

model OvertimePolicy {
  id                 BigInt   @id @default(autoincrement())
  branchId           BigInt?  @map("branch_id")
  employeeId         String?  @map("employee_id") @db.Uuid
  roleId             BigInt?  @map("role_id")
  effectiveFrom      DateTime @map("effective_from") @db.Date
  effectiveUntil     DateTime? @map("effective_until") @db.Date
  regularMultiplier  Decimal? @map("regular_multiplier") @db.Decimal(8, 4)
  restDayMultiplier  Decimal? @map("rest_day_multiplier") @db.Decimal(8, 4)
  holidayMultiplier  Decimal? @map("holiday_multiplier") @db.Decimal(8, 4)
  nightMultiplier    Decimal? @map("night_multiplier") @db.Decimal(8, 4)
  fixedHourlyRate    Decimal? @map("fixed_hourly_rate") @db.Decimal(12, 2)
  graceMinutes       Int      @default(0) @map("grace_minutes")
  dailyLimitMinutes  Int?     @map("daily_limit_minutes")
  monthlyLimitMinutes Int?    @map("monthly_limit_minutes")
  premiumOnly        Boolean  @default(true) @map("premium_only")
  approvalRequired   Boolean  @default(true) @map("approval_required")
  createdById        String   @map("created_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([employeeId, effectiveFrom])
  @@index([roleId, effectiveFrom])
  @@index([branchId, effectiveFrom])
  @@map("overtime_policies")
}

model OvertimeRequest {
  id              BigInt   @id @default(autoincrement())
  employeeId      String   @map("employee_id") @db.Uuid
  branchId        BigInt   @map("branch_id")
  startsAt        DateTime @map("starts_at")
  endsAt          DateTime @map("ends_at")
  category        String   @db.VarChar(30)
  detectedMinutes Int      @map("detected_minutes")
  approvedMinutes Int?     @map("approved_minutes")
  status          String   @default("pending") @db.VarChar(20)
  requestedById   String   @map("requested_by") @db.Uuid
  decidedById     String?  @map("decided_by") @db.Uuid
  decisionNote    String?  @map("decision_note") @db.VarChar(500)
  decidedAt       DateTime? @map("decided_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([employeeId, status, startsAt])
  @@index([branchId, status, startsAt])
  @@map("overtime_requests")
}

model HrAdjustment {
  id           BigInt   @id @default(autoincrement())
  employeeId   String   @map("employee_id") @db.Uuid
  branchId     BigInt   @map("branch_id")
  type         String   @db.VarChar(30)
  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @default("EGP") @db.VarChar(3)
  effectiveOn  DateTime @map("effective_on") @db.Date
  status       String   @default("pending") @db.VarChar(20)
  reason       String   @db.VarChar(500)
  requestedById String  @map("requested_by") @db.Uuid
  approvedById String?  @map("approved_by") @db.Uuid
  approvedAt   DateTime? @map("approved_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([employeeId, status, effectiveOn])
  @@map("hr_adjustments")
}

model EmployeeAdvance {
  id            BigInt   @id @default(autoincrement())
  employeeId    String   @map("employee_id") @db.Uuid
  branchId      BigInt   @map("branch_id")
  amount        Decimal  @db.Decimal(12, 2)
  repaidAmount  Decimal  @default(0) @map("repaid_amount") @db.Decimal(12, 2)
  currency      String   @default("EGP") @db.VarChar(3)
  status        String   @default("pending") @db.VarChar(20)
  reason        String   @db.VarChar(500)
  requestedById String   @map("requested_by") @db.Uuid
  approvedById  String?  @map("approved_by") @db.Uuid
  approvedAt    DateTime? @map("approved_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([employeeId, status, createdAt])
  @@map("employee_advances")
}

model PayrollPeriod {
  id        BigInt   @id @default(autoincrement())
  startsOn  DateTime @map("starts_on") @db.Date
  endsOn    DateTime @map("ends_on") @db.Date
  status    String   @default("draft") @db.VarChar(20)
  createdById String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([startsOn, endsOn])
  @@map("payroll_periods")
}

model PayrollRun {
  id          BigInt   @id @default(autoincrement())
  periodId    BigInt   @map("period_id")
  branchId    BigInt   @map("branch_id")
  status      String   @default("draft") @db.VarChar(20)
  createdById String   @map("created_by") @db.Uuid
  reviewedById String? @map("reviewed_by") @db.Uuid
  approvedById String? @map("approved_by") @db.Uuid
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([periodId, branchId])
  @@index([branchId, status])
  @@map("payroll_runs")
}

model PayrollLine {
  id              BigInt   @id @default(autoincrement())
  payrollRunId    BigInt   @map("payroll_run_id")
  employeeId      String   @map("employee_id") @db.Uuid
  status          String   @default("draft") @db.VarChar(20)
  grossAmount     Decimal  @map("gross_amount") @db.Decimal(12, 2)
  deductionAmount Decimal  @default(0) @map("deduction_amount") @db.Decimal(12, 2)
  paidAmount      Decimal  @default(0) @map("paid_amount") @db.Decimal(12, 2)
  netAmount       Decimal  @map("net_amount") @db.Decimal(12, 2)
  snapshot        Json
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([payrollRunId, employeeId])
  @@index([employeeId, status])
  @@map("payroll_lines")
}

model PayrollPayment {
  id             BigInt   @id @default(autoincrement())
  payrollLineId  BigInt   @map("payroll_line_id")
  amount         Decimal  @db.Decimal(12, 2)
  method         String   @db.VarChar(30)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(100)
  recordedById   String   @map("recorded_by") @db.Uuid
  recordedAt     DateTime @default(now()) @map("recorded_at")

  @@unique([payrollLineId, idempotencyKey])
  @@map("payroll_payments")
}

/// Public QR and staff service requests are operational records, not customer-auth records.
model ServiceRequest {
  id           BigInt    @id @default(autoincrement())
  branchId     BigInt    @map("branch_id")
  tableId      BigInt    @map("table_id")
  orderId      BigInt?   @map("order_id")
  type         String    @db.VarChar(30)
  status       String    @default("pending") @db.VarChar(20)
  priority     Int       @default(0) @db.SmallInt
  details      String?   @db.VarChar(500)
  claimedById  String?   @map("claimed_by") @db.Uuid
  claimedAt    DateTime? @map("claimed_at")
  resolvedById String?   @map("resolved_by") @db.Uuid
  resolvedAt   DateTime? @map("resolved_at")
  resolution   String?   @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  branch     CafeBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table      CafeTable  @relation(fields: [tableId], references: [id], onDelete: Restrict)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  claimedBy  User?      @relation("serviceRequestClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  resolvedBy User?      @relation("serviceRequestResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([branchId, status, priority, createdAt])
  @@index([tableId, status])
  @@map("service_requests")
}

model CafeTable {
  id                BigInt    @id @default(autoincrement())
  branchId          BigInt    @map("branch_id")
  number            String    @db.VarChar(20)
  name              String?   @db.VarChar(50)
  capacity          Int       @default(4) @db.SmallInt
  publicToken       String    @unique @map("public_token") @db.Char(16)
  qrImagePath       String?   @map("qr_image_path") @db.VarChar(255)
  isActive          Boolean   @default(true) @map("is_active")
  sortOrder         Int       @default(0) @map("sort_order")
  floorPlanZone     String?   @map("floor_plan_zone") @db.VarChar(80)
  floorPlanX        Decimal?  @map("floor_plan_x") @db.Decimal(7, 2)
  floorPlanY        Decimal?  @map("floor_plan_y") @db.Decimal(7, 2)
  floorPlanRotation Int       @default(0) @map("floor_plan_rotation") @db.SmallInt
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  branch          CafeBranch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders          Order[]
  serviceRequests ServiceRequest[]
  transferredFrom OrderTableTransfer[] @relation("orderTransferFromTable")
  transferredTo   OrderTableTransfer[] @relation("orderTransferToTable")

  @@unique([branchId, number])
  @@index([branchId, isActive])
  @@index([branchId, floorPlanZone])
  @@map("cafe_tables")
}

// ============================ MENU ============================

model Category {
  id        BigInt    @id @default(autoincrement())
  branchId  BigInt    @map("branch_id")
  name      String    @db.VarChar(100)
  slug      String    @db.VarChar(120)
  imagePath String?   @map("image_path") @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  branch   CafeBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  products Product[]  @relation("categoryProducts")

  @@unique([branchId, slug])
  @@index([branchId, isActive, sortOrder])
  @@map("categories")
}

model Product {
  id              BigInt    @id @default(autoincrement())
  branchId        BigInt    @map("branch_id")
  categoryId      BigInt    @map("category_id")
  name            String    @db.VarChar(150)
  description     String?   @db.Text
  imagePath       String?   @map("image_path") @db.VarChar(255)
  price           Decimal   @db.Decimal(10, 2)
  // Purchase cost — stored separately from selling price, never derived from it.
  purchaseCost    Decimal   @default(0) @map("purchase_cost") @db.Decimal(10, 2)
  // Unit of measurement: pcs, kg, g, liter, ml, etc.
  unit            String    @default("pcs") @map("unit") @db.VarChar(20)
  // Tax percentage (0–100), stored server-side; never trusted from the browser.
  taxRate         Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 2)
  // Optional direct stock mapping for packaged products. Recipe products use
  // RecipeItem rows instead; a product must never use both mechanisms.
  inventoryItemId BigInt?   @map("inventory_item_id")
  measurementUnitId BigInt? @map("measurement_unit_id")
  isActive        Boolean   @default(true) @map("is_active")
  isAvailable     Boolean   @default(true) @map("is_available")
  isFeatured      Boolean   @default(false) @map("is_featured")
  sortOrder       Int       @default(0) @map("sort_order")
  prepTimeMinutes Int       @default(5) @map("prep_time_minutes") @db.SmallInt
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  branch        CafeBranch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category      Category        @relation("categoryProducts", fields: [categoryId], references: [id])
  options       ProductOption[]
  attributeAssignments ProductAttributeAssignment[]
  variants      ProductVariant[]
  addonsAsMain  ProductAddon[]  @relation("addonProduct")
  recipes       Recipe[]
  orderItems    OrderItem[]
  inventoryItem InventoryItem?  @relation("packagedProductInventory", fields: [inventoryItemId], references: [id], onDelete: SetNull)
  measurementUnit MeasurementUnit? @relation("productMeasurementUnit", fields: [measurementUnitId], references: [id], onDelete: Restrict)

  @@index([categoryId, isActive, sortOrder])
  @@index([branchId, isActive])
  @@index([isAvailable])
  @@index([inventoryItemId])
  @@index([measurementUnitId])
  @@map("products")
}

model ProductOption {
  id            BigInt    @id @default(autoincrement())
  productId     BigInt    @map("product_id")
  name          String    @db.VarChar(100)
  type          String    @db.VarChar(20)
  isRequired    Boolean   @default(false) @map("is_required")
  minSelections Int       @default(0) @map("min_selections") @db.SmallInt
  maxSelections Int       @default(1) @map("max_selections") @db.SmallInt
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  product          Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values           ProductOptionValue[]
  orderItemOptions OrderItemOption[]

  @@index([productId, sortOrder])
  @@map("product_options")
}

model ProductOptionValue {
  id              BigInt    @id @default(autoincrement())
  productOptionId BigInt    @map("product_option_id")
  value           String    @db.VarChar(100)
  priceAdjustment Decimal   @default(0) @map("price_adjustment") @db.Decimal(10, 2)
  isDefault       Boolean   @default(false) @map("is_default")
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  productOption    ProductOption     @relation(fields: [productOptionId], references: [id], onDelete: Cascade)
  orderItemOptions OrderItemOption[]

  @@index([productOptionId, sortOrder])
  @@map("product_option_values")
}

model ProductAttribute {
  id          BigInt    @id @default(autoincrement())
  branchId    BigInt    @map("branch_id")
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  branch      CafeBranch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  values      ProductAttributeValue[]
  assignments ProductAttributeAssignment[]

  @@unique([branchId, name])
  @@index([branchId, isActive, sortOrder])
  @@map("product_attributes")
}

model ProductAttributeValue {
  id          BigInt    @id @default(autoincrement())
  attributeId BigInt    @map("attribute_id")
  label       String    @db.VarChar(100)
  numerator   Decimal?  @db.Decimal(30, 0)
  denominator Decimal?  @db.Decimal(30, 0)
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  attribute          ProductAttribute                   @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  allowedAssignments ProductAttributeAssignmentValue[]
  variantValues      ProductVariantValue[]

  @@unique([attributeId, label])
  @@index([attributeId, isActive, sortOrder])
  @@map("product_attribute_values")
}

model MeasurementUnit {
  id                    BigInt    @id @default(autoincrement())
  branchId              BigInt    @map("branch_id")
  name                  String    @db.VarChar(100)
  symbol                String    @db.VarChar(20)
  dimension             String    @db.VarChar(30)
  baseUnitId            BigInt?   @map("base_unit_id")
  conversionNumerator   Decimal?  @map("conversion_numerator") @db.Decimal(30, 0)
  conversionDenominator Decimal?  @map("conversion_denominator") @db.Decimal(30, 0)
  isActive              Boolean   @default(true) @map("is_active")
  archivedAt            DateTime? @map("archived_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  branch         CafeBranch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  baseUnit       MeasurementUnit?  @relation("measurementUnitBase", fields: [baseUnitId], references: [id], onDelete: Restrict)
  derivedUnits   MeasurementUnit[] @relation("measurementUnitBase")
  products       Product[]         @relation("productMeasurementUnit")
  inventoryItems InventoryItem[]   @relation("inventoryMeasurementUnit")
  variants       ProductVariant[]

  @@unique([branchId, name])
  @@unique([branchId, symbol])
  @@index([branchId, dimension, isActive])
  @@map("measurement_units")
}

model ProductAttributeAssignment {
  id            BigInt   @id @default(autoincrement())
  productId     BigInt   @map("product_id")
  attributeId   BigInt   @map("attribute_id")
  isRequired    Boolean  @default(false) @map("is_required")
  minSelections Int      @default(0) @map("min_selections") @db.SmallInt
  maxSelections Int      @default(1) @map("max_selections") @db.SmallInt
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product       Product                           @relation(fields: [productId], references: [id], onDelete: Restrict)
  attribute     ProductAttribute                  @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  allowedValues ProductAttributeAssignmentValue[]

  @@unique([productId, attributeId])
  @@index([attributeId])
  @@map("product_attribute_assignments")
}

model ProductAttributeAssignmentValue {
  assignmentId BigInt @map("assignment_id")
  valueId      BigInt @map("value_id")

  assignment ProductAttributeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  value      ProductAttributeValue      @relation(fields: [valueId], references: [id], onDelete: Restrict)

  @@id([assignmentId, valueId])
  @@index([valueId])
  @@map("product_attribute_assignment_values")
}

model ProductVariant {
  id                BigInt    @id @default(autoincrement())
  productId         BigInt    @map("product_id")
  measurementUnitId BigInt?   @map("measurement_unit_id")
  combinationKey    String    @map("combination_key") @db.VarChar(500)
  sku               String?   @db.VarChar(100)
  price             Decimal   @db.Decimal(10, 2)
  isActive          Boolean   @default(true) @map("is_active")
  isAvailable       Boolean   @default(true) @map("is_available")
  sortOrder         Int       @default(0) @map("sort_order")
  archivedAt        DateTime? @map("archived_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  product           Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  measurementUnit   MeasurementUnit?          @relation(fields: [measurementUnitId], references: [id], onDelete: Restrict)
  values            ProductVariantValue[]
  inventoryMappings VariantInventoryMapping[]
  orderItems        OrderItem[]

  @@unique([productId, combinationKey])
  @@unique([productId, sku])
  @@index([productId, isActive, isAvailable])
  @@index([measurementUnitId])
  @@map("product_variants")
}

model ProductVariantValue {
  variantId BigInt @map("variant_id")
  valueId   BigInt @map("value_id")

  variant ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  value   ProductAttributeValue @relation(fields: [valueId], references: [id], onDelete: Restrict)

  @@id([variantId, valueId])
  @@index([valueId])
  @@map("product_variant_values")
}

model VariantInventoryMapping {
  id              BigInt  @id @default(autoincrement())
  variantId       BigInt  @map("variant_id")
  inventoryItemId BigInt  @map("inventory_item_id")
  quantity        Decimal @db.Decimal(12, 3)

  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([variantId, inventoryItemId])
  @@index([inventoryItemId])
  @@map("variant_inventory_mappings")
}

model Addon {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(100)
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  productAddons   ProductAddon[]   @relation("addonAddon")
  orderItemAddons OrderItemAddon[]

  @@map("addons")
}

model ProductAddon {
  productId BigInt @map("product_id")
  addonId   BigInt @map("addon_id")

  product Product @relation("addonProduct", fields: [productId], references: [id], onDelete: Cascade)
  addon   Addon   @relation("addonAddon", fields: [addonId], references: [id], onDelete: Cascade)

  @@id([productId, addonId])
  @@index([addonId])
  @@map("product_addon_map")
}

// ============================ ORDERS ============================

model Order {
  id                  BigInt    @id @default(autoincrement())
  branchId            BigInt    @map("branch_id")
  cafeTableId         BigInt    @map("cafe_table_id")
  orderNumber         String    @unique @map("order_number") @db.VarChar(20)
  orderRef            String    @unique @map("order_ref") @db.Char(24)
  status              String    @default("NEW") @db.VarChar(20)
  paymentStatus       String    @default("UNPAID") @map("payment_status") @db.VarChar(20)
  orderType           String    @default("DINE_IN") @map("order_type") @db.VarChar(20)
  customerName        String?   @map("customer_name") @db.VarChar(100)
  customerPhone       String?   @map("customer_phone") @db.VarChar(20)
  notes               String?   @db.Text
  itemsSubtotal       Decimal   @map("items_subtotal") @db.Decimal(10, 2)
  discountType        String?   @map("discount_type") @db.VarChar(20)
  discountValue       Decimal   @default(0) @map("discount_value") @db.Decimal(10, 2)
  discountAmount      Decimal   @default(0) @map("discount_amount") @db.Decimal(10, 2)
  itemDiscountAmount  Decimal   @default(0) @map("item_discount_amount") @db.Decimal(10, 2)
  discountEligibleBase Decimal  @default(0) @map("discount_eligible_base") @db.Decimal(10, 2)
  taxRate             Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount           Decimal   @default(0) @map("tax_amount") @db.Decimal(10, 2)
  total               Decimal   @db.Decimal(10, 2)
  source              String    @db.VarChar(20)
  isArchived          Boolean   @default(false) @map("is_archived")
  acceptedAt          DateTime? @map("accepted_at")
  readyAt             DateTime? @map("ready_at")
  servedAt            DateTime? @map("served_at")
  // Set by the waiter when they push the order to the kitchen ("إرسال للمطبخ").
  // Null until sent — the kitchen board only shows orders the waiter dispatched.
  sentToKitchenAt     DateTime? @map("sent_to_kitchen_at")
  completedAt         DateTime? @map("completed_at")
  cancelledAt         DateTime? @map("cancelled_at")
  cancelReason        String?   @map("cancel_reason") @db.VarChar(255)
  createdById         String?   @map("created_by") @db.Uuid
  // Current operational owner. Original creation remains immutable in createdById.
  responsibleWaiterId String?   @map("responsible_waiter_id") @db.Uuid
  qrClaimedAt         DateTime? @map("qr_claimed_at")
  qrApprovedAt        DateTime? @map("qr_approved_at")
  qrRejectedAt        DateTime? @map("qr_rejected_at")
  qrDecisionById      String?   @map("qr_decision_by") @db.Uuid
  shiftId             BigInt?   @map("shift_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  branch                          CafeBranch                        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cafeTable                       CafeTable                         @relation(fields: [cafeTableId], references: [id], onDelete: Restrict)
  createdBy                       User?                             @relation("orderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  responsibleWaiter               User?                             @relation("orderResponsibleWaiter", fields: [responsibleWaiterId], references: [id], onDelete: SetNull)
  qrDecisionBy                    User?                             @relation("orderQrDecisionBy", fields: [qrDecisionById], references: [id], onDelete: SetNull)
  shift                           Shift?                            @relation("orderShift", fields: [shiftId], references: [id], onDelete: SetNull)
  items                           OrderItem[]
  payments                        Payment[]
  serviceRequests                 ServiceRequest[]
  statusHistory                   OrderStatusHistory[]
  redemptions                     DiscountRedemption[]
  notifications                   Notification[]
  responsibilityHistory           OrderResponsibilityHistory[]
  tableTransfers                  OrderTableTransfer[]
  waiterReconciliationReviews     WaiterOrderReconciliationReview[]
  waiterReconciliationAuditEvents WaiterOrderReconciliationAudit[]

  @@index([branchId, status])
  @@index([cafeTableId, status])
  @@index([branchId, createdAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([shiftId])
  @@index([branchId, responsibleWaiterId, status])
  @@map("orders")
}

/// Immutable assignment ledger. Order.responsibleWaiterId is only the current
/// operational projection; this history preserves every claim and handover.
model OrderResponsibilityHistory {
  id           BigInt   @id @default(autoincrement())
  orderId      BigInt   @map("order_id")
  branchId     BigInt   @map("branch_id")
  assignedToId String?  @map("assigned_to") @db.Uuid
  assignedById String   @map("assigned_by") @db.Uuid
  reason       String   @db.VarChar(255)
  source       String   @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at")

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  branch     CafeBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignedTo User?      @relation("orderResponsibilityAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedBy User       @relation("orderResponsibilityAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([branchId, assignedToId, createdAt])
  @@map("order_responsibility_history")
}

/// An audited move between two existing tables. This does not implement table
/// merging, and rows are never edited after creation.
model OrderTableTransfer {
  id              BigInt   @id @default(autoincrement())
  orderId         BigInt   @map("order_id")
  branchId        BigInt   @map("branch_id")
  fromTableId     BigInt   @map("from_table_id")
  toTableId       BigInt   @map("to_table_id")
  transferredById String   @map("transferred_by") @db.Uuid
  reason          String   @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")

  order         Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  branch        CafeBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  fromTable     CafeTable  @relation("orderTransferFromTable", fields: [fromTableId], references: [id], onDelete: Restrict)
  toTable       CafeTable  @relation("orderTransferToTable", fields: [toTableId], references: [id], onDelete: Restrict)
  transferredBy User       @relation(fields: [transferredById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([branchId, toTableId, createdAt])
  @@map("order_table_transfers")
}

/// A responsibility handover must be accepted by the recipient before any order
/// owner is changed. It is separate from cash handover on Shift.
model WaiterShiftHandover {
  id                BigInt    @id @default(autoincrement())
  branchId          BigInt    @map("branch_id")
  senderShiftId     BigInt    @map("sender_shift_id")
  requestedById     String    @map("requested_by") @db.Uuid
  recipientWaiterId String    @map("recipient_waiter_id") @db.Uuid
  status            String    @default("pending") @db.VarChar(20)
  notes             String?   @db.VarChar(500)
  acceptedAt        DateTime? @map("accepted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  branch          CafeBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  senderShift     Shift      @relation("waiterHandoverSenderShift", fields: [senderShiftId], references: [id], onDelete: Restrict)
  requestedBy     User       @relation("waiterHandoverRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  recipientWaiter User       @relation("waiterHandoverRecipient", fields: [recipientWaiterId], references: [id], onDelete: Restrict)

  @@index([branchId, recipientWaiterId, status])
  @@index([senderShiftId, status])
  @@map("waiter_shift_handovers")
}

/// Approval metadata for legacy orders. It is intentionally separate from
/// OrderResponsibilityHistory: approving a proposal never assigns a waiter.
model WaiterOrderReconciliationReview {
  id               BigInt    @id @default(autoincrement())
  orderId          BigInt    @map("order_id")
  branchId         BigInt    @map("branch_id")
  reviewerId       String    @map("reviewer_id") @db.Uuid
  approverId       String?   @map("approver_id") @db.Uuid
  proposedWaiterId String?   @map("proposed_waiter_id") @db.Uuid
  decision         String?   @db.VarChar(40)
  reason           String?   @db.Text
  reviewStatus     String    @default("pending_review") @map("review_status") @db.VarChar(30)
  previousState    Json      @map("previous_state") @db.JsonB
  approvedAt       DateTime? @map("approved_at")
  executionStatus  String    @default("not_executed") @map("execution_status") @db.VarChar(30)
  executedAt       DateTime? @map("executed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  order          Order                            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  branch         CafeBranch                       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reviewer       User                             @relation("waiterReconciliationReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  approver       User?                            @relation("waiterReconciliationApprover", fields: [approverId], references: [id], onDelete: SetNull)
  proposedWaiter User?                            @relation("waiterReconciliationProposedWaiter", fields: [proposedWaiterId], references: [id], onDelete: SetNull)
  auditEvents    WaiterOrderReconciliationAudit[]

  @@index([branchId, reviewStatus, createdAt])
  @@index([orderId, createdAt])
  @@index([proposedWaiterId, reviewStatus])
  @@map("waiter_order_reconciliation_reviews")
}

/// Append-only audit events for review, approval, and separately authorized execution.
model WaiterOrderReconciliationAudit {
  id              BigInt   @id @default(autoincrement())
  reviewId        BigInt   @map("review_id")
  orderId         BigInt   @map("order_id")
  branchId        BigInt   @map("branch_id")
  actorId         String   @map("actor_id") @db.Uuid
  eventType       String   @map("event_type") @db.VarChar(40)
  decision        String?  @db.VarChar(40)
  reason          String?  @db.Text
  previousState   Json     @map("previous_state") @db.JsonB
  reviewStatus    String   @map("review_status") @db.VarChar(30)
  executionStatus String   @map("execution_status") @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at")

  review WaiterOrderReconciliationReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  order  Order                           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  branch CafeBranch                      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actor  User                            @relation("waiterReconciliationAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([reviewId, createdAt])
  @@index([orderId, createdAt])
  @@index([branchId, createdAt])
  @@map("waiter_order_reconciliation_audit")
}

model OrderItem {
  id                     BigInt    @id @default(autoincrement())
  orderId                BigInt    @map("order_id")
  productId              BigInt    @map("product_id")
  productVariantId       BigInt?   @map("product_variant_id")
  productName            String    @map("product_name") @db.VarChar(150)
  unitPrice              Decimal   @map("unit_price") @db.Decimal(10, 2)
  quantity               Int       @db.SmallInt
  lineTotal              Decimal   @map("line_total") @db.Decimal(10, 2)
  discountType           String?   @map("discount_type") @db.VarChar(20)
  discountValue          Decimal   @default(0) @map("discount_value") @db.Decimal(10, 2)
  discountAmount         Decimal   @default(0) @map("discount_amount") @db.Decimal(10, 2)
  eligibleForInvoiceDiscount Boolean @default(true) @map("eligible_for_invoice_discount")
  optionsSnapshot        Json?     @map("options_snapshot")
  productVariantSnapshot Json?     @map("product_variant_snapshot")
  notes                  String?   @db.VarChar(255)
  prepTimeMinutes        Int       @default(0) @map("prep_time_minutes") @db.SmallInt
  isVoided               Boolean   @default(false) @map("is_voided")
  voidReason             String?   @map("void_reason") @db.VarChar(255)
  preparedQuantity       Int       @default(0) @map("prepared_quantity") @db.SmallInt
  servedQuantity         Int       @default(0) @map("served_quantity") @db.SmallInt
  preparationStartedAt   DateTime? @map("preparation_started_at")
  preparationStartedById String?   @map("preparation_started_by") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  order                 Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant        ProductVariant?        @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  addons                OrderItemAddon[]
  options               OrderItemOption[]
  preparationStartedBy  User?                  @relation("itemPreparationStartedBy", fields: [preparationStartedById], references: [id], onDelete: SetNull)
  reservations          InventoryReservation[]
  inventoryTransactions InventoryTransaction[]
  wasteEvents           WasteEvent[]

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
  @@index([orderId, isVoided])
  @@map("order_items")
}

model OrderItemAddon {
  id          BigInt   @id @default(autoincrement())
  orderItemId BigInt   @map("order_item_id")
  addonId     BigInt   @map("addon_id")
  addonName   String   @map("addon_name") @db.VarChar(100)
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int      @default(1) @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addon     Addon     @relation(fields: [addonId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([addonId])
  @@map("order_item_addons")
}

model OrderItemOption {
  id              BigInt   @id @default(autoincrement())
  orderItemId     BigInt   @map("order_item_id")
  productOptionId BigInt   @map("product_option_id")
  optionValueId   BigInt   @map("option_value_id")
  optionName      String   @map("option_name") @db.VarChar(100)
  valueLabel      String   @map("value_label") @db.VarChar(100)
  priceAdjustment Decimal  @map("price_adjustment") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  orderItem     OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productOption ProductOption      @relation(fields: [productOptionId], references: [id], onDelete: Restrict)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@map("order_item_options")
}

model OrderStatusHistory {
  id          BigInt   @id @default(autoincrement())
  orderId     BigInt   @map("order_id")
  fromStatus  String?  @map("from_status") @db.VarChar(20)
  toStatus    String   @map("to_status") @db.VarChar(20)
  changedById String?  @map("changed_by") @db.Uuid
  note        String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation("statusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Notification {
  id        BigInt   @id @default(autoincrement())
  userId    String   @db.Uuid
  orderId   BigInt?
  type      String   @db.VarChar(60)
  title     String   @db.VarChar(255)
  body      String?  @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([orderId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================ PAYMENTS ============================

model Payment {
  id              BigInt   @id @default(autoincrement())
  orderId         BigInt   @map("order_id")
  branchId        BigInt   @map("branch_id")
  method          String   @db.VarChar(20)
  amount          Decimal  @db.Decimal(10, 2)
  amountDue       Decimal  @map("amount_due") @db.Decimal(10, 2)
  changeAmount    Decimal  @default(0) @map("change_amount") @db.Decimal(10, 2)
  status          String   @db.VarChar(20)
  transactionRef  String?  @map("transaction_ref") @db.VarChar(100)
  gateway         String?  @db.VarChar(30)
  gatewayResponse Json?    @map("gateway_response")
  paidById        String?  @map("paid_by") @db.Uuid
  shiftId         BigInt?  @map("shift_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  order  Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branch CafeBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  paidBy User?      @relation("paymentPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  shift  Shift?     @relation("paymentShift", fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([branchId, createdAt])
  @@index([method])
  @@index([shiftId])
  @@map("payments")
}

// ==================== SHIFTS (MVP P0) ====================
// One open till session per branch: opening float, expected cash vs counted
// cash at close, variance. Orders/payments link via optional shiftId (SetNull).

model Shift {
  id                  BigInt    @id @default(autoincrement())
  branchId            BigInt    @map("branch_id")
  // Display snapshot of whoever opened the till (audit FK lives in cashierId).
  openBy              String    @map("open_by")
  cashierId           String?   @map("cashier_id") @db.Uuid
  openingCash         Decimal   @default(0) @map("opening_cash") @db.Decimal(10, 2)
  // expected = opening + cash received − cash refunded (computed at close).
  expectedCash        Decimal   @default(0) @map("expected_cash") @db.Decimal(10, 2)
  closingCash         Decimal   @default(0) @map("closing_cash") @db.Decimal(10, 2)
  // actual − expected: positive = excess, negative = shortage.
  cashDifference      Decimal   @default(0) @map("cash_difference") @db.Decimal(10, 2)
  status              String    @default("open") @db.VarChar(20)
  openedAt            DateTime  @default(now()) @map("opened_at")
  closedAt            DateTime? @map("closed_at")
  // Handover / reconciliation fields — recorded when the cashier closes the
  // till. handoverTo names the receiving manager/authorized employee.
  handoverNotes       String?   @map("handover_notes") @db.VarChar(1000)
  handoverTo          String?   @map("handover_to") @db.VarChar(100)
  handoverCompletedAt DateTime? @map("handover_completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  branch                 CafeBranch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashier                User?                  @relation("shiftCashier", fields: [cashierId], references: [id], onDelete: SetNull)
  orders                 Order[]                @relation("orderShift")
  payments               Payment[]              @relation("paymentShift")
  financialMovements     FinancialMovement[]
  attendanceCorrections  AttendanceCorrection[]
  waiterHandoverRequests WaiterShiftHandover[]  @relation("waiterHandoverSenderShift")

  @@index([branchId, status])
  @@index([cashierId])
  @@map("shifts")
}

// Immutable cash-ledger entries. A movement is a transfer between named cash
// accounts, never revenue. Corrections are represented by a reversing entry.
model FinancialMovement {
  id                 BigInt    @id @default(autoincrement())
  branchId           BigInt    @map("branch_id")
  // Reversal type names (for example fixed_float_withdrawal_reversal) need
  // 31 characters; keep a small, explicit margin for immutable ledger types.
  type               String    @db.VarChar(40)
  status             String    @default("posted") @db.VarChar(20)
  amount             Decimal   @db.Decimal(10, 2)
  sourceAccount      String    @map("source_account") @db.VarChar(30)
  destinationAccount String    @map("destination_account") @db.VarChar(30)
  sourceShiftId      BigInt?   @map("source_shift_id")
  destinationUserId  String?   @map("destination_user_id") @db.Uuid
  actorId            String?   @map("actor_id") @db.Uuid
  reason             String    @db.VarChar(255)
  occurredAt         DateTime  @default(now()) @map("occurred_at")
  consumedAt         DateTime? @map("consumed_at")
  metadata           Json?
  reversalOfId       BigInt?   @unique @map("reversal_of_id")
  advanceId          BigInt?   @map("advance_id")
  createdAt          DateTime  @default(now()) @map("created_at")

  branch          CafeBranch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sourceShift     Shift?              @relation(fields: [sourceShiftId], references: [id], onDelete: Restrict)
  destinationUser User?               @relation("movementRecipient", fields: [destinationUserId], references: [id], onDelete: Restrict)
  actor           User?               @relation("movementActor", fields: [actorId], references: [id], onDelete: SetNull)
  reversalOf      FinancialMovement?  @relation("movementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal        FinancialMovement?  @relation("movementReversal")
  advance         FinancialMovement?  @relation("advanceRepayments", fields: [advanceId], references: [id], onDelete: Restrict)
  repayments      FinancialMovement[] @relation("advanceRepayments")

  @@index([branchId, type, occurredAt])
  @@index([sourceShiftId])
  @@index([destinationUserId, consumedAt])
  @@index([advanceId])
  @@map("financial_movements")
}

// Durable response record for retry-safe monetary operations. Rows are written
// in the same transaction as the resulting ledger/payment record.
model FinancialOperation {
  id             BigInt     @id @default(autoincrement())
  branchId       BigInt     @map("branch_id")
  actorId        String     @map("actor_id") @db.Uuid
  operationType  String     @map("operation_type") @db.VarChar(40)
  idempotencyKey String     @map("idempotency_key") @db.VarChar(100)
  fingerprint    String     @db.VarChar(128)
  result         Json
  createdAt      DateTime   @default(now()) @map("created_at")
  branch         CafeBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([branchId, actorId, operationType, idempotencyKey])
  @@map("financial_operations")
}

// ==================== INVENTORY (schema ready, dormant in v1) ====================

model InventoryItem {
  id           BigInt    @id @default(autoincrement())
  branchId     BigInt    @map("branch_id")
  name         String    @db.VarChar(100)
  sku          String?   @db.VarChar(50)
  unit         String    @db.VarChar(20)
  measurementUnitId BigInt? @map("measurement_unit_id")
  currentStock Decimal   @default(0) @map("current_stock") @db.Decimal(10, 2)
  minStock     Decimal   @default(0) @map("min_stock") @db.Decimal(10, 2)
  unitCost     Decimal   @default(0) @map("unit_cost") @db.Decimal(10, 2)
  isTracked    Boolean   @default(true) @map("is_tracked")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  branch           CafeBranch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  recipeItems      RecipeItem[]
  transactions     InventoryTransaction[]
  batches          InventoryBatch[]
  reservations     InventoryReservation[]
  packagedProducts Product[]              @relation("packagedProductInventory")
  variantInventoryMappings VariantInventoryMapping[]
  measurementUnit MeasurementUnit? @relation("inventoryMeasurementUnit", fields: [measurementUnitId], references: [id], onDelete: Restrict)
  stockCountLines  StockCountLine[]

  @@unique([branchId, sku])
  @@index([branchId, isActive])
  @@index([measurementUnitId])
  @@map("inventory_items")
}

model Recipe {
  id            BigInt    @id @default(autoincrement())
  productId     BigInt    @unique @map("product_id")
  yieldQuantity Decimal   @default(1) @map("yield_quantity") @db.Decimal(10, 2)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   RecipeItem[]

  @@map("recipes")
}

model RecipeItem {
  id              BigInt  @id @default(autoincrement())
  recipeId        BigInt  @map("recipe_id")
  inventoryItemId BigInt  @map("inventory_item_id")
  quantity        Decimal @db.Decimal(10, 2)
  wastePercent    Decimal @default(0) @map("waste_percent") @db.Decimal(5, 2)

  recipe        Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([recipeId, inventoryItemId])
  @@map("recipe_items")
}

model InventoryTransaction {
  id              BigInt   @id @default(autoincrement())
  inventoryItemId BigInt   @map("inventory_item_id")
  branchId        BigInt   @map("branch_id")
  type            String   @db.VarChar(20)
  quantity        Decimal  @db.Decimal(10, 2)
  quantityAfter   Decimal  @map("quantity_after") @db.Decimal(10, 2)
  referenceType   String?  @map("reference_type") @db.VarChar(30)
  referenceId     BigInt?  @map("reference_id")
  unitCost        Decimal? @map("unit_cost") @db.Decimal(10, 2)
  costTotal       Decimal  @default(0) @map("cost_total") @db.Decimal(12, 2)
  orderItemId     BigInt?  @map("order_item_id")
  createdById     String?  @map("created_by") @db.Uuid
  notes           String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")

  inventoryItem  InventoryItem              @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  branch         CafeBranch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy      User?                      @relation("txnCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  orderItem      OrderItem?                 @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  allocations    InventoryBatchAllocation[]
  stockCountLine StockCountLine?

  @@index([inventoryItemId, createdAt])
  @@index([branchId, type, createdAt])
  @@index([orderItemId])
  @@map("inventory_transactions")
}

// Inventory batches preserve physical FEFO picking and independent FIFO cost
// layers. Legacy on-hand stock intentionally has no synthetic batch: it must be
// reconciled into an authorised opening batch before automated consumption.
model InventoryBatch {
  id                    BigInt    @id @default(autoincrement())
  inventoryItemId       BigInt    @map("inventory_item_id")
  branchId              BigInt    @map("branch_id")
  receivedAt            DateTime  @default(now()) @map("received_at")
  expiresAt             DateTime? @map("expires_at")
  originalQuantity      Decimal   @map("original_quantity") @db.Decimal(12, 3)
  remainingQuantity     Decimal   @map("remaining_quantity") @db.Decimal(12, 3)
  remainingCostQuantity Decimal   @map("remaining_cost_quantity") @db.Decimal(12, 3)
  unitCost              Decimal   @map("unit_cost") @db.Decimal(12, 4)
  supplierReference     String?   @map("supplier_reference") @db.VarChar(120)
  createdById           String?   @map("created_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")

  inventoryItem  InventoryItem              @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  branch         CafeBranch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  allocations    InventoryBatchAllocation[]
  StockCountLine StockCountLine[]

  @@index([inventoryItemId, expiresAt, receivedAt])
  @@index([inventoryItemId, receivedAt])
  @@map("inventory_batches")
}

model InventoryReservation {
  id               BigInt    @id @default(autoincrement())
  branchId         BigInt    @map("branch_id")
  orderItemId      BigInt    @map("order_item_id")
  inventoryItemId  BigInt    @map("inventory_item_id")
  quantity         Decimal   @db.Decimal(12, 3)
  consumedQuantity Decimal   @default(0) @map("consumed_quantity") @db.Decimal(12, 3)
  releasedQuantity Decimal   @default(0) @map("released_quantity") @db.Decimal(12, 3)
  status           String    @default("active") @db.VarChar(20)
  createdAt        DateTime  @default(now()) @map("created_at")
  releasedAt       DateTime? @map("released_at")
  consumedAt       DateTime? @map("consumed_at")

  branch        CafeBranch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, inventoryItemId])
  @@index([inventoryItemId, status])
  @@index([branchId, status])
  @@map("inventory_reservations")
}

// A physical allocation (FEFO) and a costing allocation (FIFO) are recorded
// separately, so traceability never pretends that the two policies are equal.
model InventoryBatchAllocation {
  id                     BigInt   @id @default(autoincrement())
  inventoryBatchId       BigInt   @map("inventory_batch_id")
  inventoryTransactionId BigInt   @map("inventory_transaction_id")
  allocationType         String   @db.VarChar(12)
  quantity               Decimal  @db.Decimal(12, 3)
  unitCost               Decimal  @db.Decimal(12, 4)
  createdAt              DateTime @default(now()) @map("created_at")

  inventoryBatch       InventoryBatch       @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)
  inventoryTransaction InventoryTransaction @relation(fields: [inventoryTransactionId], references: [id], onDelete: Cascade)

  @@index([inventoryBatchId, allocationType])
  @@index([inventoryTransactionId])
  @@map("inventory_batch_allocations")
}

// A count is immutable after posting. The application records every stock
// adjustment as an InventoryTransaction; this session stores the physical
// observation and the reconciliation decision.
model StockCount {
  id             BigInt    @id @default(autoincrement())
  branchId       BigInt    @map("branch_id")
  responsibleId  String    @map("responsible_id") @db.Uuid
  type           String    @db.VarChar(20) // weekly | monthly | ad_hoc
  status         String    @default("draft") @db.VarChar(20) // draft | counting | submitted | posted | cancelled
  snapshotAt     DateTime  @default(now()) @map("snapshot_at")
  submittedAt    DateTime? @map("submitted_at")
  postedAt       DateTime? @map("posted_at")
  postedById     String?   @map("posted_by") @db.Uuid
  cancelledAt    DateTime? @map("cancelled_at")
  cancelReason   String?   @map("cancel_reason") @db.VarChar(255)
  idempotencyKey String?   @map("idempotency_key") @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  branch      CafeBranch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  responsible User             @relation("stockCountResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  postedBy    User?            @relation("stockCountPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  lines       StockCountLine[]

  @@unique([branchId, idempotencyKey])
  @@index([branchId, status, createdAt])
  @@index([responsibleId, status])
  @@map("stock_counts")
}

model StockCountLine {
  id                  BigInt   @id @default(autoincrement())
  stockCountId        BigInt   @map("stock_count_id")
  inventoryItemId     BigInt   @map("inventory_item_id")
  inventoryBatchId    BigInt?  @map("inventory_batch_id")
  expectedQuantity    Decimal  @map("expected_quantity") @db.Decimal(12, 3)
  countedQuantity     Decimal? @map("counted_quantity") @db.Decimal(12, 3)
  varianceQuantity    Decimal? @map("variance_quantity") @db.Decimal(12, 3)
  fifoCostTotal       Decimal? @map("fifo_cost_total") @db.Decimal(12, 2)
  valuationMetadata   Json?    @map("valuation_metadata")
  postedTransactionId BigInt?  @unique @map("posted_transaction_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  stockCount        StockCount            @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryBatch    InventoryBatch?       @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)
  postedTransaction InventoryTransaction? @relation(fields: [postedTransactionId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, inventoryItemId, inventoryBatchId])
  @@index([inventoryItemId])
  @@index([inventoryBatchId])
  @@map("stock_count_lines")
}

model WasteEvent {
  id            BigInt   @id @default(autoincrement())
  branchId      BigInt   @map("branch_id")
  orderItemId   BigInt?  @map("order_item_id")
  responsibleId String?  @map("responsible_id") @db.Uuid
  recordedById  String?  @map("recorded_by") @db.Uuid
  quantity      Decimal  @db.Decimal(12, 3)
  cause         String   @db.VarChar(40)
  reason        String   @db.VarChar(255)
  costTotal     Decimal  @default(0) @map("cost_total") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  branch         CafeBranch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  orderItem      OrderItem?              @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  responsible    User?                   @relation("wasteResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  recordedBy     User?                   @relation("wasteRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  accountability EmployeeAccountability?

  @@index([branchId, createdAt])
  @@map("waste_events")
}

// Durable retry record for non-financial inventory write-offs. It is written
// in the same transaction as the movement so browser/network retries cannot
// deduct stock twice.
model WasteOperation {
  id             BigInt   @id @default(autoincrement())
  branchId       BigInt   @map("branch_id")
  actorId        String   @map("actor_id") @db.Uuid
  operationType  String   @map("operation_type") @db.VarChar(40)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(100)
  fingerprint    String   @db.VarChar(128)
  result         Json
  createdAt      DateTime @default(now()) @map("created_at")

  branch CafeBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([branchId, actorId, operationType, idempotencyKey])
  @@map("waste_operations")
}

model EmployeeAccountability {
  id              BigInt    @id @default(autoincrement())
  branchId        BigInt    @map("branch_id")
  employeeId      String    @map("employee_id") @db.Uuid
  wasteEventId    BigInt?   @unique @map("waste_event_id")
  amount          Decimal   @db.Decimal(12, 2)
  waivedAmount    Decimal   @default(0) @map("waived_amount") @db.Decimal(12, 2)
  deductedAmount  Decimal   @default(0) @map("deducted_amount") @db.Decimal(12, 2)
  reviewStatus    String    @default("pending_review") @map("review_status") @db.VarChar(30)
  legalApprovedAt DateTime? @map("legal_approved_at")
  reviewedById    String?   @map("reviewed_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  branch     CafeBranch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  employee   User                   @relation("accountabilityEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  wasteEvent WasteEvent?            @relation(fields: [wasteEventId], references: [id], onDelete: SetNull)
  reviewedBy User?                  @relation("accountabilityReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  waivers    AccountabilityWaiver[]
  deductions PayrollDeduction[]

  @@index([branchId, employeeId, reviewStatus])
  @@map("employee_accountability")
}

model AccountabilityWaiver {
  id               BigInt   @id @default(autoincrement())
  accountabilityId BigInt   @map("accountability_id")
  amount           Decimal  @db.Decimal(12, 2)
  reason           String   @db.VarChar(255)
  managerId        String   @map("manager_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  accountability EmployeeAccountability @relation(fields: [accountabilityId], references: [id], onDelete: Restrict)
  manager        User                   @relation("waiverManager", fields: [managerId], references: [id], onDelete: Restrict)

  @@index([accountabilityId, createdAt])
  @@map("accountability_waivers")
}

// A legal/manager-approved payroll settlement only. Creation is intentionally
// separate from the automatic accountability record.
model PayrollDeduction {
  id               BigInt   @id @default(autoincrement())
  accountabilityId BigInt   @map("accountability_id")
  amount           Decimal  @db.Decimal(12, 2)
  payrollPeriod    String   @map("payroll_period") @db.VarChar(20)
  approvedById     String   @map("approved_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  accountability EmployeeAccountability @relation(fields: [accountabilityId], references: [id], onDelete: Restrict)

  @@unique([accountabilityId, payrollPeriod])
  @@map("payroll_deductions")
}

// ============================ DISCOUNTS ============================

model Discount {
  id                BigInt    @id @default(autoincrement())
  branchId          BigInt?   @map("branch_id")
  name              String    @db.VarChar(100)
  code              String?   @db.VarChar(30)
  type              String    @db.VarChar(20)
  value             Decimal   @db.Decimal(10, 2)
  minOrderTotal     Decimal?  @map("min_order_total") @db.Decimal(10, 2)
  maxDiscountAmount Decimal?  @map("max_discount_amount") @db.Decimal(10, 2)
  usageLimit        Int?      @map("usage_limit")
  usageCount        Int       @default(0) @map("usage_count")
  startsAt          DateTime? @map("starts_at")
  endsAt            DateTime? @map("ends_at")
  isActive          Boolean   @default(true) @map("is_active")
  createdById       String?   @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  branch      CafeBranch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy   User?                @relation("discountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  redemptions DiscountRedemption[]

  @@index([branchId, isActive])
  @@index([code])
  @@index([startsAt, endsAt])
  @@map("discounts")
}

model DiscountRedemption {
  id         BigInt   @id @default(autoincrement())
  discountId BigInt   @map("discount_id")
  orderId    BigInt   @map("order_id")
  amount     Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([discountId, orderId])
  @@index([orderId])
  @@map("discount_redemptions")
}

// ============================ SETTINGS & AUDIT ============================

model AppSetting {
  id          BigInt   @id @default(autoincrement())
  branchId    BigInt   @default(0) @map("branch_id")
  key         String   @db.VarChar(80)
  value       String?  @db.Text
  type        String   @default("string") @db.VarChar(20)
  updatedById String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("settingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([branchId, key])
  @@map("app_settings")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @map("user_id") @db.Uuid
  branchId   BigInt?  @map("branch_id")
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   BigInt?  @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  user   User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch CafeBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([branchId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
